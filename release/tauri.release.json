{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "../../.tmp/release/stage/app/": "app/",
      "../../.tmp/release/stage/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"],
        "customLanguageFiles": {
          "Japanese": "../../release/nsis/Japanese.nsh"
        },
        "startMenuFolder": "Awalia",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "../../release/nsis-hooks.nsh"
      }
    }
  }
}
